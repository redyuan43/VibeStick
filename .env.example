# VibeStick battery telemetry configuration.
# Copy to .env for local telemetry scripts. Normal voice, ASR, OTA serving,
# provider observation, and paste behavior are configured in CapsWriter.

# Shared token used by telemetry and copied into firmware secrets by setup.sh.
# Configure the same device token in CapsWriter.
VIBE_STICK_BRIDGE_TOKEN=

# Optional telemetry-specific override. Empty falls back to the bridge token.
VIBE_STICK_TELEMETRY_TOKEN=
VIBE_STICK_TELEMETRY_PORT=8878
VIBE_STICK_TELEMETRY_URL=http://127.0.0.1:8878
